+    def _primal_fuse(self, x_l, x_a, x_v):
+        """Trimodal fusion of the three (L, N, 2d) streams; same input scaling and
+        embedding dropout as MulT's TransformerEncoder, final LayerNorm like it too."""
+        scale = math.sqrt(x_l.shape[-1])
+        xs = [F.dropout(scale * x.transpose(0, 1), p=self.embed_dropout, training=self.training)
+              for x in (x_l, x_a, x_v)]                       # (N, L, 2d) for the block
+        for blk in self.primal_blocks:
+            xs = blk(*xs)
+        return [norm(x).transpose(0, 1) for norm, x in zip(self.primal_norms, xs)]
